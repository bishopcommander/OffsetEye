# eRTMAC-NWIS — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.

# ─── PostgreSQL ────────────────────────────────────────────────────────────────
PGHOST=localhost
PGPORT=5432
PGDATABASE=ertmac_nwis
PGUSER=postgres
PGPASSWORD=your_postgres_password_here

# ─── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=8h

# ─── LLM API ───────────────────────────────────────────────────────────────────
# NOTE: Document text and embeddings are sent to this third-party API.
# Acceptable here ONLY because this prototype uses public/synthetic data
# (Volve, Sodir, FORCE 2020, 3W, Texas RRC) — never real OIL data.
# A production OIL deployment must reconsider this (self-hosted embeddings/LLM).
LLM_PROVIDER=openai          # openai | anthropic | gemini
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gpt-4o-mini

# ─── Server ────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
